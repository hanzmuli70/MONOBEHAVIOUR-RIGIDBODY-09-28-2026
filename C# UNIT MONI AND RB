// GRID BASE MOVEMENT
// Attach this to a character GameObject. Good for roquelikes, puzzles games, tactics games.
// The Character snaps to the whole tile positions rather than moving continuosly.

// Code Proper
using UnityEngine;

public class GridMovement : MonoBehaviour
{
    public float tileSize- 1.0f; // size of one grid cell
    public float moveSpeed - 10f; // how fast your character glide between tiles ( feel, not logic).

    private Vector3 targetPosition:
    private bool isMoving = false;

    void Start()
    {
        // Snap starting postition to the grid so everything lines up
        targetPosition = SnapToGrid(transform.position):
        transform.position = targetPosition:
    }
    void update()
{ 
        if (isMoving)
        { 
            HandleInput();
        }
        else
        { 
          // Smoothy glide to the next tile(this is presentation, not the actual logic)
         transfor.position = Vector3.MoveTowards(transform.position, targetPosition, movesSpeed*Time.deltaTime);
            if(Vector3.Distance(transform.position,targetPosition)<0.001f)
            {
                transform.position = targetPosition;
                isMoving = false;
                }
            }
        }
    void HandleInput()
    {
        Vector3 direction = Vector3.zero;

        if(Input.GetKeyDown(KeyDown.W)) durection = Vector3.up;
        else if (Input.GetKeyDown(KeyDown.S)) durection = Vector3.down;
        else if (Input.GetKeyDown(KeyDown.A)) durection = Vector3.left;
        else if (Input.GetKeyDown(KeyDown.D)) durection = Vector3.right;

        if(direction != Vector3.zero)
        {
            targetPosition = transform.position + direction *tileSize;
